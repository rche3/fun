# ---- Copy this file to ".env" and fill it in ----

# The public HTTPS base URL where this server is reachable.
# For local testing, run a tunnel (e.g. `cloudflared tunnel --url http://localhost:3000`)
# and paste the https URL it gives you here. Apple's servers AND the iPhone must be
# able to reach this URL, so http://localhost will NOT work for real Wallet updates.
BASE_URL=https://your-tunnel-subdomain.trycloudflare.com

# From your Apple Developer account:
PASS_TYPE_ID=pass.com.yourdomain.loyalty
TEAM_ID=ABCDE12345

# Branding shown on the card
ORG_NAME=Cafe Amber
CARD_TITLE=Cafe Amber Loyalty
REWARD_TEXT=Free coffee at 10 stamps

# Passphrase you set when exporting the signing key (leave blank if none)
CERT_PASSPHRASE=

# Loyalty rules
MAX_STAMPS=10
# Minimum seconds between two stamps on the same card (anti accidental double-tap).
# Keep low (e.g. 3) while testing; raise to e.g. 3600 for real use.
STAMP_COOLDOWN_SECONDS=3

# Protects the /admin page. Use Basic Auth: username can be anything, password = this.
ADMIN_PASSWORD=changeme

# Default shop id used when a tag URL omits one
DEFAULT_SHOP_ID=shop1

PORT=3000
